{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["arn1", "fra1"],
  "functions": {
    "app/api/investigate/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/generate-pr/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "env": {
    "WATSONX_REGION": "eu-de",
    "WATSONX_MODEL": "meta-llama/llama-3-3-70b-instruct"
  }
}
