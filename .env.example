# IBM watsonx AI Configuration
# Get your credentials from: https://cloud.ibm.com/catalog/services/watsonx-ai

# Required: Your IBM Cloud API Key
WATSONX_API_KEY=your_api_key_here

# Required: Your watsonx.ai Project ID
WATSONX_PROJECT_ID=your_project_id_here

# Optional: IBM Cloud Region (default: us-south)
# Options: us-south, eu-gb, eu-de, jp-tok
WATSONX_REGION=us-south

# Optional: Model to use (default: ibm/granite-13b-chat-v2)
# Options:
#   - ibm/granite-13b-chat-v2 (recommended for code analysis)
#   - ibm/granite-20b-code-instruct
#   - meta-llama/llama-2-70b-chat
WATSONX_MODEL=ibm/granite-13b-chat-v2

# Development Settings
# Set to 'false' to use mock data instead of AI (useful for testing)
USE_AI=true

# Next.js Configuration
NODE_ENV=development